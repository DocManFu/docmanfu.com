{
  "name": "docmanfu-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SEO-friendly Eleventy marketing site for DocManFu",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "eleventy",
    "clean": "node scripts/clean.mjs",
    "test": "npm run clean && npm run build && node scripts/verify-site.mjs",
    "test:links": "node scripts/verify-site.mjs",
    "docker:build": "docker build -t docmanfu-marketing ."
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6"
  },
  "overrides": {
    "@11ty/recursive-copy": "5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
